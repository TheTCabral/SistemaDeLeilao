<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MenuVendedorController"
      spacing="20" alignment="CENTER" style="-fx-padding: 40; -fx-background-color: #f5f5f5;">

    <Label fx:id="lblBoasVindas" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Separator prefWidth="400"/>

    <VBox spacing="15" alignment="CENTER">
        <Button text="Gerenciar Meus Itens" onAction="#handleGerenciarItens"
                style="-fx-font-size: 16px; -fx-background-color: #2196F3; -fx-text-fill: white;"
                prefWidth="300" prefHeight="50"/>

        <Button text="Meus Leilões" onAction="#handleMeusLeiloes"
                style="-fx-font-size: 16px; -fx-background-color: #4CAF50; -fx-text-fill: white;"
                prefWidth="300" prefHeight="50"/>

        <Button text="Relatórios de Vendas" onAction="#handleRelatorios"
                style="-fx-font-size: 16px; -fx-background-color: #FF9800; -fx-text-fill: white;"
                prefWidth="300" prefHeight="50"/>

        <Button text="Sair" onAction="#handleSair"
                style="-fx-font-size: 16px; -fx-background-color: #9E9E9E; -fx-text-fill: white;"
                prefWidth="300" prefHeight="50"/>
    </VBox>

    <Label fx:id="lblStatus" style="-fx-text-fill: red;"/>
</VBox>
