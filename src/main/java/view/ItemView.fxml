<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ItemController">

    <!-- Topo -->
    <top>
        <VBox style="-fx-padding: 10; -fx-background-color: #2196F3;">
            <Label fx:id="lblBoasVindas" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Centro - Tabela -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Meus Itens Cadastrados" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="200"/>
                    <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="300"/>
                    <TableColumn fx:id="colValor" text="Valor Inicial (R$)" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Criar Leilão" onAction="#handleCriarLeilao"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Excluir Item" onAction="#handleExcluir"
                        style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
                <Button text="Voltar ao Menu" onAction="#handleVoltar"/>
            </HBox>
        </VBox>
    </center>

    <!-- Direita - Formulário -->
    <right>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f0f0f0;" prefWidth="350">
            <Label text="Cadastrar/Editar Item" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Separator/>

            <Label text="Nome do Item:"/>
            <TextField fx:id="txtNome" promptText="Ex: Notebook Dell XPS"/>

            <Label text="Descrição:"/>
            <TextArea fx:id="txtDescricao" promptText="Descrição detalhada do item"
                      prefHeight="100" wrapText="true"/>

            <Label text="Valor Inicial (R$):"/>
            <TextField fx:id="txtValor" promptText="0.00"/>

            <Label text="URL da Imagem (opcional):"/>
            <TextField fx:id="txtImagemUrl" promptText="http://..."/>

            <HBox spacing="10">
                <Button fx:id="btnSalvar" text="Cadastrar Item" onAction="#handleSalvar"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="lblStatus" style="-fx-text-fill: red; -fx-font-weight: bold;" wrapText="true"/>
        </VBox>
    </right>
</BorderPane>