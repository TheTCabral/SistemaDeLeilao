<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LanceController" spacing="10" style="-fx-padding: 20;">

    <Label fx:id="lblItemNome" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="lblItemDescricao"/>
    <Separator/>
    <Label fx:id="lblMaiorLance" style="-fx-font-size: 14px;"/>
    <Label fx:id="lblVendedor" style="-fx-font-size: 12px;"/>
    <Separator/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Seu Lance (R$):" minWidth="100"/>
        <TextField fx:id="txtValorLance" promptText="0.00" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Button text="Confirmar Lance" onAction="#handleConfirmarLance" defaultButton="true"/>
    <Label fx:id="lblStatus" />

    <Button text="Voltar para Lista" onAction="#handleVoltar" cancelButton="true"/>
</VBox>