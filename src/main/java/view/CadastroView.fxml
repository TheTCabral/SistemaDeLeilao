<!-- ========== CadastroView.fxml ========== -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CadastroController"
      spacing="15" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: #f5f5f5;">

    <Label text="Cadastro de Usuário" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Separator/>

    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <Label text="Nome Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNome" promptText="Digite seu nome completo"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtEmail" promptText="seu@email.com"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>

        <Label text="CPF:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtCpf" promptText="000.000.000-00"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"
                   onKeyReleased="#handleFormatarCpf"/>

        <Label text="Senha:" GridPane.columnIndex="0" GridPane.rowIndex="3"
               style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtSenha" promptText="Mínimo 6 caracteres"
                       GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>

        <Label text="Confirmar Senha:" GridPane.columnIndex="0" GridPane.rowIndex="4"
               style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="txtConfirmaSenha" promptText="Digite novamente"
                       GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>

        <Label text="Tipo de Usuário:" GridPane.columnIndex="0" GridPane.rowIndex="5"
               style="-fx-font-weight: bold;"/>
        <HBox spacing="20" GridPane.columnIndex="1" GridPane.rowIndex="5">
            <RadioButton fx:id="rbComprador" text="Comprador"/>
            <RadioButton fx:id="rbVendedor" text="Vendedor"/>
        </HBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Cadastrar" onAction="#handleCadastrar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                prefWidth="120"/>
        <Button text="Voltar" onAction="#handleVoltar"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"
                prefWidth="120"/>
    </HBox>

    <Label fx:id="lblStatus" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
</VBox>
