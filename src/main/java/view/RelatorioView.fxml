<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RelatorioController">

    <top>
        <VBox style="-fx-padding: 10; -fx-background-color: #673AB7;">
            <Label text="Relatórios e Estatísticas"
                   style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <!-- Cards de Estatísticas -->
                <GridPane hgap="20" vgap="20">
                    <VBox style="-fx-background-color: #4CAF50; -fx-padding: 20; -fx-background-radius: 10;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Total de Leilões" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblTotalLeiloes" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox style="-fx-background-color: #2196F3; -fx-padding: 20; -fx-background-radius: 10;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Total de Lances" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblTotalLances" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox style="-fx-background-color: #FF9800; -fx-padding: 20; -fx-background-radius: 10;"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Valor Médio Lance" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="lblValorMedio" text="R$ 0,00"
                               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>
                </GridPane>

                <Separator/>

                <!-- Tabela de Compradores Mais Ativos -->
                <VBox spacing="10">
                    <Label text="Compradores Mais Ativos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tabelaCompradoresAtivos" prefHeight="200">
                        <columns>
                            <TableColumn text="Nome" prefWidth="200"/>
                            <TableColumn text="Total de Lances" prefWidth="150"/>
                            <TableColumn text="Valor Total (R$)" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Gráfico -->
                <VBox spacing="10">
                    <Label text="Leilões por Status" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <PieChart fx:id="chartLeiloeStatus" prefHeight="300"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Button text="Atualizar Dados" onAction="#handleAtualizar"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            <Button text="Exportar PDF" onAction="#handleExportarPDF"
                    style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
            <Button text="Voltar" onAction="#handleVoltar"/>
        </HBox>
    </bottom>
</BorderPane>